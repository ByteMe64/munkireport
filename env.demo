# =============================================================================
# Demo environment template (local Docker Compose)
# =============================================================================
#
# Setup steps:
#
#   1. Copy this file to .env:
#        cp env.demo .env
#
#   2. Generate an admin password hash and paste it into ADMIN_PASSWORD_HASH:
#        bash generate-admin-hash.sh
#
#   3. Generate the TLS certificate for DOMAIN (default: localhost):
#        bash generate-demo-cert.sh
#
#   4. Trust the CA on this Mac (and on every Mac client that will connect):
#        sudo security add-trusted-cert -d -r trustRoot \
#          -k /Library/Keychains/System.keychain ${CERT_DIR}/ca.crt
#
#   5. If DOMAIN is not localhost, add a hosts entry on each machine:
#        echo "127.0.0.1 munkireport.local" | sudo tee -a /etc/hosts
#
#   6. Deploy:
#        docker compose -f docker-compose.yml -f docker-compose.demo.yml up -d --build
#
#   7. Configure Mac clients — edit client-setup.sh:
#        SERVER_URL="https://<DOMAIN>/"
#        PASSPHRASE="<CLIENT_PASSPHRASE value from below>"
#      Then run on each Mac:
#        sudo bash client-setup.sh
#
# =============================================================================

# Image versions
MARIADB_VERSION=11.4
BUSYBOX_VERSION=latest

# Database
MYSQL_ROOT_PASSWORD=demo-root-password
MYSQL_DATABASE=munkireport
MYSQL_USER=munkireport
MYSQL_PASSWORD=demo-db-password

# MunkiReport
SITENAME=MunkiReport Demo

# Admin user
ADMIN_USERNAME=admin
ADMIN_REALNAME=Administrator
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD_HASH='CHANGE_ME — run ./generate-admin-hash.sh'

# TLS — for local demo, use localhost or add a custom name to /etc/hosts
DOMAIN=localhost
ACME_EMAIL=admin@localhost

# Certificate directory — where generate-demo-cert.sh writes and Traefik reads
CERT_DIR=./certs

# Client passphrase — must match the value in client-setup.sh on each Mac
CLIENT_PASSPHRASE=demo-passphrase
