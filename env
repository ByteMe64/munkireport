# Image versions
MARIADB_VERSION=11.4
BUSYBOX_VERSION=latest

# Database
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=munkireport
MYSQL_USER=munkireport
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# MunkiReport
SITENAME=MunkiReport

# Admin user — written into local/users/admin.yml at deploy time.
# The hash MUST be single-quoted so docker compose does not interpolate the $ chars.
# Generate with: ./generate-admin-hash.sh
ADMIN_USERNAME=admin
ADMIN_REALNAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2y$10$78iiH/7OG0b/iDTdl3pEue2Zzo1VPMbiOdqml9P716TreQqcTEqaS'

# Reverse proxy / TLS
# DOMAIN must have a public DNS A record pointing at this server (for Let's Encrypt).
# Host-side ports — defaults are 80/443. Change if those are in use (e.g. 8080/8443).
# Note: Let's Encrypt HTTP-01 requires port 80 reachable from the internet,
# so non-default HTTP_PORT only works if something upstream forwards :80 to it.
HTTP_PORT=80
HTTPS_PORT=443
DOMAIN=munkireport.yourdomain.com
ACME_EMAIL=admin@example.com

# Client authentication — Mac clients must set this passphrase in their config
CLIENT_PASSPHRASE=CHANGE_ME_CLIENT_PASSPHRASE
