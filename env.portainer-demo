# =============================================================================
# Demo environment template (Portainer stack deployment)
# =============================================================================
#
# Setup steps:
#
#   1. In Portainer: Stacks → Add stack → Git Repository
#      - Repository URL: <this repo>
#      - Branch: feature/demo-tls
#      - Compose path: docker-compose.portainer-demo.yml
#
#   2. Under "Environment variables", add the variables below.
#      Generate ADMIN_PASSWORD_HASH first on any machine with htpasswd:
#        bash generate-admin-hash.sh
#
#   3. Click "Deploy the stack"
#
#   4. Extract the CA cert from the cert-init container:
#        docker cp cert-init:/certs/ca.crt ./ca.crt
#
#   5. Trust the CA on every Mac client that will connect:
#        sudo security add-trusted-cert -d -r trustRoot \
#          -k /Library/Keychains/System.keychain ca.crt
#
#   6. If DOMAIN is not localhost, add a hosts entry on each client
#      pointing to the Portainer host IP:
#        echo "<HOST_IP> munkireport.local" | sudo tee -a /etc/hosts
#
#   7. Configure Mac clients — edit client-setup.sh:
#        SERVER_URL="https://<DOMAIN>/"
#        PASSPHRASE="<CLIENT_PASSPHRASE value from below>"
#      Then run on each Mac:
#        sudo bash client-setup.sh
#
# =============================================================================

# Image versions
MUNKIREPORT_VERSION=5.8.1
MARIADB_VERSION=11.4
TRAEFIK_VERSION=v3.3
ALPINE_VERSION=3.20
BUSYBOX_VERSION=latest

# Database
MYSQL_ROOT_PASSWORD=demo-root-password
MYSQL_DATABASE=munkireport
MYSQL_USER=munkireport
MYSQL_PASSWORD=demo-db-password

# MunkiReport
SITENAME=MunkiReport Demo
MODULES=disk_report,managedinstalls,munkireport,munkireportinfo,applications,inventory,network,security,filevault_status,softwareupdate,displays_info,installhistory,user_sessions,mdm_status,power,wifi
AUTH_METHODS=LOCAL
ALLOW_MIGRATIONS=TRUE

# Admin user
ADMIN_USERNAME=admin
ADMIN_REALNAME=Administrator
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD_HASH='CHANGE_ME — run ./generate-admin-hash.sh'

# TLS — hostname for the generated certificate
DOMAIN=munkireport.local

# Client passphrase — must match the value in client-setup.sh on each Mac
CLIENT_PASSPHRASE=demo-passphrase
